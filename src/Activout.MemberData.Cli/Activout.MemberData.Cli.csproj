<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>member</AssemblyName>
    <RootNamespace>Activout.MemberData.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>member</ToolCommandName>
    <PackageId>Activout.MemberData.Cli</PackageId>
    <Description>The member command: sync your own LinkedIn Member Data Portability data into a local SQLite database and query it.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Activout.DatabaseClient.Dapper" Version="5.0.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Activout.MemberData/Activout.MemberData.csproj" />
    <InternalsVisibleTo Include="Activout.MemberData.Cli.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../skills/member/SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>

</Project>
